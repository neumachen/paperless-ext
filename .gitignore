.ci-reports/

# Integration evidence produced by the containerized test suite
.evidence/
**/.evidence/
# Archived copies of earlier evidence runs, kept so a later pass cannot
# overwrite a run somebody has already reviewed. Local-only, like .evidence.
.evidence-retained/
**/.evidence-retained/

# Local-only credentials for the File Normalizer foundation stack
deploy/filename-normalizer/secrets/
