{
  "version": 1,

  "storage": {
    "incoming": "/var/lib/filename-normalizer/incoming",
    "queued": "/var/lib/filename-normalizer/queued",
    "staging": "/var/lib/filename-normalizer/staging",
    "consume": "/var/lib/filename-normalizer/consume",
    "failed": "/var/lib/filename-normalizer/failed"
  },

  "discovery": {
    "enabled": true,
    "interval": "10s",
    "stability_interval": "30s",
    "completion": "stability",
    "recursive": false,
    "batch": 100,
    "max_file_bytes": 0,

    "include": ["\\.(pdf|jpe?g|png|tiff?|heic|txt|docx?|odt)$"],
    "exclude": ["^~\\$", "^\\.#"],
    "match_case_insensitive": true,

    "temporary_suffixes": [".part", ".tmp", ".crdownload", ".partial", ".filepart"]
  },

  "normalization": {
    "max_name_bytes": 200,
    "max_extension_length": 16,
    "max_collision_suffix": 9999,
    "require_extension": true,

    "rules": []
  },

  "processing": {
    "concurrency": 2,
    "prefetch": 2,
    "max_delivery_attempts": 5,
    "dry_run": false
  }
}
