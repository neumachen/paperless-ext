# File Normalizer local foundation stack.
#
# Copy to .env and set the three passwords before starting. These credentials
# exist only for the isolated local stack; no port is published for the
# database or the broker, and nothing here may be reused for a real system.
#
#   cp .env.example .env && ${EDITOR:-vi} .env
#
# Or let the Makefile generate throwaway values:
#
#   make env
#
# --- project isolation ---
# Every container, network and volume is prefixed with this name, so
# `make down-clean` removes only this project's resources.
COMPOSE_PROJECT_NAME=fnfoundation

# --- application identity stamped into the images ---
FN_VERSION=0.1.0-foundation
FN_REVISION=unknown
FN_BUILD_DATE=unknown
FN_IMAGE_PREFIX=filename-normalizer

# --- credentials (required; deliberately empty) ---
FN_DB_PASSWORD=
FN_REPLICATION_PASSWORD=
FN_AMQP_PASSWORD=

# --- database ---
FN_DB_NAME=filename_normalizer
FN_DB_USER=fn_app
FN_REPLICATION_USER=fn_repl
FN_REPLICATION_SLOT=fn_standby_1
# The standby is asynchronous and is not required for readiness by default.
# Set to true to make a lost standby mark both applications not-ready.
FN_DB_REPLICA_REQUIRED=false

# --- broker ---
FN_AMQP_USER=fn_app
FN_AMQP_VHOST=filename-normalizer
# Bounded retries: the broker dead-letters a delivery after this many attempts.
FN_AMQP_DELIVERY_LIMIT=5

# --- applications ---
FN_LOG_LEVEL=info
FN_SHUTDOWN_TIMEOUT=20s
FN_RENAMER_CONCURRENCY=2
FN_WATCHER_DISPATCH_INTERVAL=500ms
FN_WATCHER_DISPATCH_BATCH=32
FN_WATCHER_DISPATCH_CLAIM_MAX_AGE=30s
FN_WATCHER_ACCOUNTING_INTERVAL=2s

# --- host ports for the applications' HTTP surfaces only ---
FN_WATCHER_PORT=18080
FN_RENAMER1_PORT=18081
FN_RENAMER2_PORT=18082

# --- fixtures ---
FN_FIXTURE_COUNT=12
